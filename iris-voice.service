[Unit]
Description=Iris voice: OmniVoice behind Iris's speech API (voice/server.py)
# install.sh fills in the placeholders.
After=default.target

[Service]
Type=simple
ExecStart=CODE_DIR/.venv/bin/python SERVER_PY HOST_ARGS --port VOICE_PORT
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
